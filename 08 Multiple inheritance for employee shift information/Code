#include <iostream>  //includes cin and cout
#include <string>  //includes string data type

using namespace std;

class EmployeeBasicInfo {  //first base class named for basic info employee
protected:  //variables will be protected but child class can access it
    string name;  //stores name of employee
    int id;  //stores employee id

public:
    void getBasicData() {
        cout << "Enter Employee ID: ";  //prompts user to enter id
        cin >> id;
        cout << "Enter Name: ";  //prompts user to enter name
        cin >> name;
    }
};

class ProjectPerformanceInfo {
protected:
    float completionPercentage;

public:
    void getPerformanceData() {
        cout << "Enter Completion Percentage (0-100): ";
        cin >> completionPercentage;
    }
};

class ProjectEvaluation : public EmployeeBasicInfo, public ProjectPerformanceInfo {
private:
    float performanceScore;

public:
    void calculateCompletionScore() {
        performanceScore = (completionPercentage / 100.0f) * 5.0f;
    }

    void displayReport() {
        cout << "\nProject Report\n";
        cout << "Employee ID: " << id << "\n";
        cout << "Name: " << name << "\n";
        cout << "Performance Score (1-5): " << performanceScore << "\n";
    }
};

int main() {
    ProjectEvaluation emp;
    
    emp.getBasicData();
    emp.getPerformanceData();
    emp.calculateCompletionScore();
    emp.displayReport();

    return 0;
}
