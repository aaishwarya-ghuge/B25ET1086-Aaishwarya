#include <iostream>
using namespace std;

class Complex
{
    float real, imag;

public:
    void getData()
    {
        cout << "Enter real part: ";
        cin >> real;
        cout << "Enter imaginary part: ";
        cin >> imag;
    }

    void reciprocal()
    {
        float denominator = real * real + imag * imag;

        if (denominator == 0)
        {
            cout << "Reciprocal does not exist.";
            return;
        }

        float r = real / denominator;
        float i = -imag / denominator;

        cout << "Reciprocal = " << r;

        if (i >= 0)
            cout << " + " << i << "i";
        else
            cout << " - " << -i << "i";
    }
};

int main()
{
    Complex c;

    c.getData();
    c.reciprocal();

    return 0;
}
